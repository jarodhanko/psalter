# Optional private issue reports. Disabled in unconfigured/fork builds.
# Copy to .env.local, then set your own project and exact site origins.
# VITE_ values are embedded in public JavaScript: NEVER put secrets here.
VITE_ISSUE_REPORTS_ENABLED=false
VITE_FIREBASE_PROJECT_ID=
VITE_ISSUE_REPORT_ALLOWED_ORIGINS=
# Example own-project origins: https://your-site.example,http://localhost:5173
# Publish and emulator-test create-only Firestore rules before enabling intake.
